generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        Int      @id @default(autoincrement())
  name      String
  phone     String   @unique
  password  String
  role      Role     @default(MEMBER)
  createdAt DateTime @default(now())

  memberships ChitMember[]
  payments    Payment[]
  bids        Bid[]
  withdrawals Withdrawal[]
}

model ChitGroup {
  id             Int      @id @default(autoincrement())
  name           String
  totalAmount    Float
  durationMonths Int
  monthlyAmount  Float
  startDate      DateTime
  status         String   @default("ACTIVE")

  members      ChitMember[]
  installments Installment[]
}

model ChitMember {
  id       Int @id @default(autoincrement())
  userId   Int
  chitId   Int
  position Int

  user User      @relation(fields: [userId], references: [id])
  chit ChitGroup @relation(fields: [chitId], references: [id])

  @@unique([userId, chitId])
}

model Installment {
  id          Int      @id @default(autoincrement())
  chitId      Int
  monthNumber Int
  dueDate     DateTime
  status      String   @default("PENDING")

  chit     ChitGroup @relation(fields: [chitId], references: [id])
  payments Payment[]
  bids     Bid[]
}

model Payment {
  id            Int      @id @default(autoincrement())
  userId        Int
  chitId        Int
  installmentId Int
  amount        Float
  status        String   @default("PAID")
  createdAt     DateTime @default(now())

  user        User        @relation(fields: [userId], references: [id])
  installment Installment @relation(fields: [installmentId], references: [id])

  @@unique([userId, installmentId]) // prevent double payment
}

model Bid {
  id            Int      @id @default(autoincrement())
  userId        Int
  chitId        Int
  installmentId Int
  bidAmount     Float
  createdAt     DateTime @default(now())

  user        User        @relation(fields: [userId], references: [id])
  installment Installment @relation(fields: [installmentId], references: [id])

  @@unique([userId, installmentId]) // one bid per user
}

model Winner {
  id            Int      @id @default(autoincrement())
  chitId        Int
  installmentId Int
  userId        Int
  winningBid    Float
  payoutAmount  Float
  createdAt     DateTime @default(now())
}

enum Role {
  ADMIN
  MEMBER
}

model Ledger {
  id            Int      @id @default(autoincrement())
  userId        Int
  chitId        Int
  installmentId Int
  amount        Float
  type          String // CREDIT / DEBIT
  createdAt     DateTime @default(now())
}

model Withdrawal {
  id        Int      @id @default(autoincrement())
  userId    Int
  amount    Float
  status    String   @default("PENDING")
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
}
